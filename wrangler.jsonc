{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nomawork",
  "compatibility_date": "2026-03-17",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nomawork-production",
      "database_id": "local-nomawork-db"
    }
  ]
}
